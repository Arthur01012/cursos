# Preserve annotations and inner classes required for reflection.
-keepattributes Signature,Annotation,InnerClasses,EnclosingMethod

# Obfuscate source-file names and preserve real line numbers.
-renamesourcefileattribute SourceFile
-keepattributes SourceFile,LineNumberTable

# Keep all classes and members in the Modelo package.
-keep class com.example.cursos.Modelo.** { *; }
-keepclassmembers class com.example.cursos.Modelo.** { *; }

# Keep members annotated with Kotlin serialization annotations.
-keepclassmembers class * {
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class * {
    @kotlinx.serialization.SerialName *;
}

# Keep generated Kotlin serializers and Companion members.
-keepclassmembers class *$$serializer { *; }
-keepclassmembers class * {
    * Companion;
}

# Keep API interfaces and HTTP-annotated methods.
-keep interface com.example.cursos.InterfaceApi.** { *; }
-keepclassmembers class * {
    @retrofit2.http.* <methods>;
}

# Suppress warnings for Retrofit, OkHttp, Okio, and Glide.
-dontwarn retrofit2.**
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn com.bumptech.glide.**

# Keep OkHttp's public suffix database class name.
-keepnames class okhttp3.internal.publicsuffix.PublicSuffixDatabase

# Keep Glide modules and their constructors.
-keep public class * extends com.bumptech.glide.module.AppGlideModule
-keep class * implements com.bumptech.glide.module.GlideModule
-keepclassmembers class * implements com.bumptech.glide.module.GlideModule {
    public <init>();
}
